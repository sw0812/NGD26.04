<?xml version="1.0"?>

<robot name="simple_robot">

  <!-- Base Link -->
  <link name="base_link">
    <visual>

      <geometry>
        <box size="0.4 0.3 0.2"/>
      </geometry>

      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>

    </visual>
  </link>

  <!-- Camera Link -->
  <link name="camera_link">
    <visual>

      <geometry>
        <box size="0.2 0.1 0.1"/>
      </geometry>

      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>

    </visual>
  </link>

  <!-- Joint -->
  <joint name="camera_joint" type="revolute">
    <parent link="base_link"/>
    <child link="camera_link"/>

    <origin 
     xyz="0.2 0 0.15" 
     rpy="0 0 0"/>

    <aixs xyz="0 0 1"/>

    <limit lower="-1.57"
           upper="1.57"
           effort="10"
           velocity="1"/>
  </joint>

</robot>

