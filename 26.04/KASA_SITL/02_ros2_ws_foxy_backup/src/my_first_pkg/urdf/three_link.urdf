<?xml version="1.0"?>
<robot name="three_link_robot">

  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.2 0.2 0.05"/>
      </geometry>
      <material name="Black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.2 0.2 0.05"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="6.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0"
               izz="0.001"/>
    </inertial>
  </link>

  <link name="link1">
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.3"/>
      </geometry>
      <material name="Black">
        <color rgba="0.1 0.1 0.1 1"/>

      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.03" length="0.3"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0"
               izz="0.001"/>
    </inertial>
  </link>

  <joint name="base_to_link1" type="fixed">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>

  <link name="link2">
    <visual>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <material name="Black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0"
               izz="0.001"/>
    </inertial>
  </link>

<link name="lidar_link">
 <visual>

  <geometry>
   <cylinder radius="0.03" length="0.04"/>
  </geometry>

  <material name="grey">
   <color rgba="0.3 0.3 0.3 1"/>
  </material>

  </visual>

 <collision>
 
  <geometry>
   <cylinder radius="0.03" length="0.04"/>
  </geometry>

 <origin xyz="0 0 0" rpy="0 0 0"/>

 </collision>

  <inertial>
   <mass value="0.1"/>
   <origin xyz="0 0 0"/>
   <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
  </inertial>

</link>

 <joint name="base_to_lidar" type="fixed">
  <parent link="base_link"/>
  <child link="lidar_link"/>
  <origin xyz="0 0 0.05" rpy="0 0 0"/>
 </joint>

<gazebo reference="lidar_link">
  <sensor type="ray" name="lidar_sensor">
    <update_rate>10</update_rate>
    <ray>
      <scan>
        <horizontal>
          <samples>360</samples>
          <resolution>1</resolution>
          <min_angle>-3.14159</min_angle>
          <max_angle>3.14159</max_angle>
        </horizontal>
      </scan>
      <range>
        <min>0.12</min>
        <max>10.0</max>
        <resolution>0.01</resolution>
      </range>
    </ray>
    <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
      <ros>
        <namespace>/</namespace>
        <remapping>~/out:=scan</remapping>
      </ros>
      <output_type>sensor_msgs/LaserScan</output_type>
      <frame_name>lidar_link</frame_name>
    </plugin>
  </sensor>
</gazebo>

  <link name="wheel">
    <visual>
      <geometry>
        <cylinder radius="0.06" length="0.02"/>
      </geometry>
      <material name="Black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.06" length="0.02"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0"
               izz="0.001"/>
    </inertial>
  </link>

  <link name="lift">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.1"/>
      </geometry>
      <material name="Black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
  
 <collision>

      <geometry>
        <box size="0.05 0.05 0.1"/>
      </geometry>
     
    <origin xyz="0 0 0" rpy="0 0 0"/>
   
 </collision>

    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0"
               izz="0.001"/>
    </inertial>

  </link>


<link name="camera_link">
 <visual>

  <geometry>
   <box size="0.03 0.03 0.03"/>
  </geometry>

  <material name="white">
   <color rgba="1 1 1 1"/>
  </material>

  </visual>

  <collision>

   <geometry>
    <box size="0.03 0.03 0.03"/>
   </geometry>

   <origin xyz="0 0 0" rpy="0 0 0"/>

  </collision>

  <inertial>
   <mass value="0.05"/>
   <origin xyz="0 0 0" rpy="0 0 0"/>
   <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
  </inertial>
</link>

<joint name="lift_to_camera" type="fixed">

 <parent link="lift"/>
 <child link="camera_link"/>

 <origin xyz="0 0 0.065" rpy="0 0 0"/>

</joint>

<gazebo reference="camera_link">
  <sensor type="camera" name="camera_sensor">
    <update_rate>30.0</update_rate>
    <camera>
      <horizontal_fov>1.3962634</horizontal_fov>
      <image>
        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.02</near>
        <far>300</far>
      </clip>
    </camera>
    <plugin name="camera_plugin" filename="libgazebo_ros_camera.so">
      <ros>
        <namespace>/camera</namespace>
      </ros>
      <camera_name>camera</camera_name>
      <frame_name>camera_link</frame_name>
    </plugin>
  </sensor>
</gazebo>

<link name="imu_link">
 <visual>
  <geometry>
   <box size="0.03 0.03 0.01"/>
  </geometry>
 </visual>
 <collision>
  <geometry>
   <box size="0.03 0.03 0.01"/>
  </geometry>
 </collision>
 <inertial>
  <mass value="0.05"/>
  <origin xyz="0 0 0" rpy="0 0 0"/>
  <inertia
      ixx="0.00001"
      ixy="0"
      ixz="0"
      iyy="0.00001"
      iyz="0"
      izz="0.00001"/>
 </inertial>
</link>
<joint name="base_to_imu" type="fixed">
 <parent link="base_link"/>
 <child link="imu_link"/>
 <origin xyz="0 0 0.04" rpy="0 0 0"/>
</joint>
<gazebo reference="imu_link">
  <sensor name="imu_sensor" type="imu">
    <always_on>true</always_on>
    <update_rate>100</update_rate>
    <plugin
      filename="libgazebo_ros_imu_sensor.so"
      name="imu_plugin">
      <ros>
        <namespace>/</namespace>
        <remapping>~/out:=imu</remapping>
      </ros>
      <frame_name>imu_link</frame_name>
    </plugin>
  </sensor>
</gazebo>

<link name="right_wheel">
  <visual>
    <geometry>
      <cylinder radius="0.05" length="0.03"/>
    </geometry>
    <material name="Black"><color rgba="0.1 0.1 0.1 1"/></material>
  </visual>
  <collision>
    <geometry>
      <cylinder radius="0.05" length="0.03"/>
    </geometry>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </collision>
  <inertial>
    <mass value="0.5"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <inertia ixx="0.0005" ixy="0.0" ixz="0.0" iyy="0.0005" iyz="0.0" izz="0.0005"/>
  </inertial>
</link>

<joint name="base_to_right_wheel" type="continuous">
  <parent link="base_link"/>
  <child link="right_wheel"/>
  <origin xyz="0 -0.12 -0.03" rpy="1.5708 0 0"/>
  <axis xyz="0 0 1"/>
</joint>

<link name="left_wheel">

 <visual>

  <geometry>
   <cylinder radius="0.05" length="0.03"/>
  </geometry>

 <origin xyz="0 0 0" rpy="0 0 0"/>

  <material name="Black"><color rgba="0.1 0.1 0.1 1"/></material>
 </visual>
 
  <collision>
 
   <geometry>
      <cylinder radius="0.05" length="0.03"/>
   </geometry>
    <origin xyz="0 0 0" rpy="0 0 0"/>

  </collision>

  <inertial>

    <mass value="0.5"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <inertia ixx="0.0005" ixy="0.0" ixz="0.0" iyy="0.0005" iyz="0.0" izz="0.0005"/>

  </inertial>

<link name="caster_wheel_front">
  <visual>
    <geometry>
      <sphere radius="0.03"/>
    </geometry>
    <material name="Black">
      <color rgba="0.1 0.1 0.1 1"/>
    </material>
  </visual>
  <collision>
    <geometry>
      <sphere radius="0.03"/>
    </geometry>
  </collision>
  <inertial>
    <mass value="0.2"/>
    <origin xyz="0 0 0"/>
    <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
  </inertial>
</link>
<joint name="base_to_caster_front" type="fixed">
  <parent link="base_link"/>
  <child link="caster_wheel_front"/>
  <origin xyz="0.09 0 -0.05"/>
</joint>

</link>		

<link name="caster_wheel">

  <visual>
    <geometry>
      <sphere radius="0.03"/>
    </geometry>

    <material name="Black">
      <color rgba="0.1 0.1 0.1 1"/>
    </material>

  </visual>

  <collision>
    <geometry>
      <sphere radius="0.03"/>
    </geometry>
  </collision>

  <inertial>
    <mass value="0.2"/>
    <origin xyz="0 0 0"/>
    <inertia
      ixx="0.0001"
      ixy="0"
      ixz="0"
      iyy="0.0001"
      iyz="0"
      izz="0.0001"/>
  </inertial>

</link>

<joint name="base_to_caster" type="fixed">

  <parent link="base_link"/>
  <child link="caster_wheel"/>

  <origin xyz="-0.09 0 -0.05"/>

</joint>

<joint name="base_to_left_wheel" type="continuous">
  
  <parent link="base_link"/>
  <child link="left_wheel"/>
  <origin xyz="0 0.12 -0.03" rpy="1.5708 0 0"/>
  <axis xyz="0 0 1"/>
 
</joint>

  <joint name="wheel_to_lift" type="prismatic">
    <parent link="wheel"/>
    <child link="lift"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="0.1" effort="10" velocity="0.5"/>
  </joint>

  <joint name="link1_to_link2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
  </joint>

  <joint name="link2_to_wheel" type="continuous">
    <parent link="link2"/>
    <child link="wheel"/>
    <origin xyz="0 0 0.1" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

<ros2_control name="three_link_system" type="system">
  <hardware>
    <plugin>gazebo_ros2_control/GazeboSystem</plugin>
  </hardware>
  <joint name="link1_to_link2">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="link2_to_wheel">
    <command_interface name="velocity"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="wheel_to_lift">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
   <joint name="base_to_left_wheel">
     <command_interface name="velocity"/>
     <state_interface name="position"/>
     <state_interface name="velocity"/>
   </joint>
   <joint name="base_to_right_wheel">
     <command_interface name="velocity"/>
     <state_interface name="position"/>
     <state_interface name="velocity"/>
    </joint>

</ros2_control>

<gazebo reference="base_link">
  <material>Gazebo/Grey</material>
  <mu1>0.8</mu1>
  <mu2>0.8</mu2>

</gazebo>

<gazebo reference="link1">
  <material>Gazebo/Grey</material>
  <mu1>0.8</mu1>
  <mu2>0.8</mu2>

</gazebo>

<gazebo reference="link2">
  <material>Gazebo/Grey</material>
  <mu1>0.8</mu1>
  <mu2>0.8</mu2>

</gazebo>

<gazebo reference="wheel">
  <material>Gazebo/Grey</material>
  <mu1>0.8</mu1>
  <mu2>0.8</mu2>
</gazebo>

<gazebo reference="lift">
  <material>Gazebo/Grey</material>
  <mu1>0.8</mu1>
  <mu2>0.8</mu2>

</gazebo>

<gazebo>
  <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
    <parameters>/home/sasllab/ros2_ws/src/my_first_pkg/config/controllers.yaml</parameters>
  </plugin>
</gazebo>

</robot>
