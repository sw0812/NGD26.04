<?xml version="1.0"?>
<model>
  <name>tarot680pro</name>
  <version>1.0</version>
  <sdf version="1.5">tarot680pro.sdf</sdf>

  <author>
   <name></name>
   <email></email>
  </author>

  <description>
    TAROT Iron Man 680 Pro hexacopter (Hexa X) for PX4 SITL / Gazebo Classic.
    695 mm motor-to-motor folding CF frame, 6x Tarot 4006-620KV motors on 4S,
    13x5.5 CF props, ~2.8 kg all-up weight. Sensor/plugin blocks (IMU, mag,
    baro, GPS, mavlink_interface) carried over from this PX4 tree's own
    6011_gazebo-classic_typhoon_h480 model; gimbal/camera/landing-gear
    removed since the 680 Pro has none.
  </description>
</model>
