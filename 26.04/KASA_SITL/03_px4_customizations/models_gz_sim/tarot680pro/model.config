<?xml version="1.0"?>
<model>
  <name>tarot680pro</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    TAROT Iron Man 680 Pro Hexacopter (Hexa X), ported from this tree's
    Gazebo Classic tarot680pro model (Tools/simulation/gazebo-classic/sitl_gazebo-classic/models/tarot680pro)
    to run under the new Gazebo (gz-sim). Physical params (mass, inertia,
    rotor geometry, motor constants, turning directions) copied 1:1 from
    the flight-tested Classic model - see that model's tarot680pro.sdf
    comments for rotor index/angle/direction derivation.
  </description>
</model>
