<?xml version="1.0"?>
<sdf version="1.6">
  <model name="aruco_test_marker">
    <static>true</static>
    <link name="link">
      <!-- A <plane> coplanar with empty.world's own ground plane never
           rendered at all (tried 1mm and 3cm offsets, RGB vs grayscale
           texture - none of it was the cause). Trying an actual thin box
           (real volume) instead of a coplanar infinite-plane-on-plane. -->
      <pose>0 0 0.01 0 0 0</pose>
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <box>
            <size>0.6 0.6 0.02</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>model://aruco_test_marker/materials/scripts</uri>
            <uri>model://aruco_test_marker/materials/textures</uri>
            <name>Kasa/ArucoTestMarker0</name>
          </script>
        </material>
      </visual>
    </link>
  </model>
</sdf>
