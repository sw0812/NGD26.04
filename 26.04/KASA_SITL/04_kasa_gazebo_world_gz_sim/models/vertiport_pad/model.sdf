<?xml version="1.0"?>
<sdf version="1.9">
  <model name="vertiport_pad">
    <static>true</static>
    <link name="pad">
      <pose>0 0 0.35 0 0 0</pose>
      <collision name="pad_collision">
        <geometry><cylinder><radius>1.5</radius><length>0.7</length></cylinder></geometry>
      </collision>
      <visual name="pad_visual">
        <geometry><cylinder><radius>1.5</radius><length>0.7</length></cylinder></geometry>
        <material>
          <ambient>0.35 0.35 0.4 1</ambient>
          <diffuse>0.5 0.5 0.55 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>

    <!-- 상판 표식: 외곽링+안전구역링+V픽토그램+중앙 ArUco(ID0). Classic 모델과 동일 치수. -->
    <link name="marker">
      <pose>0 0 0.701 0 0 0</pose>
      <visual name="marker_visual">
        <geometry><plane><normal>0 0 1</normal><size>3.2 3.2</size></plane></geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://vertiport_pad/materials/textures/vertiport_marker.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>

    <joint name="marker_fixed" type="fixed">
      <parent>pad</parent>
      <child>marker</child>
    </joint>
  </model>
</sdf>
