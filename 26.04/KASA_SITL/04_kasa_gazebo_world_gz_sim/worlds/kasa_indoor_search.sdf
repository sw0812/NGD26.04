<?xml version="1.0" encoding="UTF-8"?>
<!-- KASA indoor search world, ported from the Gazebo Classic world
     kasa_gazebo_world/worlds/kasa_indoor_search.world (that file is
     auto-generated by scripts/generate_field.py - this port is manual,
     re-sync by hand if the Classic world regenerates with different
     grid/marker placement).

     Coordinate system, mission area, waypoint IDs: unchanged, see the
     Classic world file's own header comment.

     UNLIKE the Classic world, tarot680pro is NOT embedded here. Classic
     embedded it directly because its spawn mechanism is "the model's own
     mavlink_interface plugin connects out once gzserver is already
     running" - embedding avoided a GPS-sample discontinuity at spawn
     time (see that world file's own comment). gz-sim's spawn mechanism
     is different: PX4's gz_bridge module spawns PX4_SIM_MODEL via a
     runtime EntityFactory service call keyed on the model name, which is
     the standard pattern every other gz world+model in this tree
     (x500_flow, x500_lidar_down, ...) relies on - embedding the vehicle
     here too would likely either double-spawn it or collide on the
     model name. The airframe file (6022_gz_tarot680pro) sets
     PX4_SIM_MODEL=tarot680pro and PX4_GZ_WORLD=kasa_indoor_search so
     that runtime spawn targets this world. Whether the original
     GPS-glitch concern re-appears under this different spawn mechanism
     is UNVERIFIED (couldn't run gz-sim at all on this machine - see
     03_px4_customizations notes) - if it does, embedding may need to
     come back, but do that as a deliberate follow-up fix, not a
     copy-paste precaution.
-->
<sdf version="1.9">
  <world name="kasa_indoor_search">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <!-- 실내(공장) 임무 컨셉 - 낮은 조도. Classic 월드와 동일. -->
    <scene>
      <grid>false</grid>
      <ambient>0.35 0.35 0.38 1</ambient>
      <background>0.1 0.1 0.12 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ===================================================================
         좌표계: 버티포트(출발점) 중심 = (0,0,0).
         드론 스폰 위치 : (0.0, 0.0, 0.75)  <- 버티포트 상판 위
         Mission area   : x [2.0 .. 26.0]  y [2.0 .. 17.0]
         경로점(ArUco)   : ID1(8.0, 5.0), ID2(11.0, 14.0), ID3(17.0, 8.0), ID4(23.0, 14.0)
         =================================================================== -->

    <!-- 바닥면: safe area 32x23m + mission area 24x15m + 3m 격자 + 경로점 ArUco 4개 -->
    <include>
      <uri>model://kasa_ground_field</uri>
      <pose>14.0 9.5 0 0 0 0</pose>
    </include>

    <!-- 버티포트: 지름 3m, 높이 0.7m, 상판에 V픽토그램 + 중앙 ArUco(ID0) -->
    <include>
      <uri>model://vertiport_pad</uri>
      <pose>0.0 0.0 0 0 0 0</pose>
    </include>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <gui>
      <camera name="user_camera">
        <pose>12.0 -14.5 20 0 0.72 1.5708</pose>
      </camera>
    </gui>
  </world>
</sdf>
